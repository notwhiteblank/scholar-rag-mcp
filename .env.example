# Scholar-RAG-MCP configuration. You can also place these values in <data_dir>/config.json (JSON, same keys without the SCHOLAR_RAG_ prefix); environment variables always win.

SCHOLAR_RAG_DATA_DIR=~/.scholar-rag
SCHOLAR_RAG_QDRANT_URL=
SCHOLAR_RAG_QDRANT_BIN=
SCHOLAR_RAG_QDRANT_PORT=6333
SCHOLAR_RAG_QDRANT_STORAGE_DIR=~/.local/share/scholar-rag/qdrant
SCHOLAR_RAG_CHAT_BACKEND=api
SCHOLAR_RAG_CHAT_BASE_URL=
SCHOLAR_RAG_CHAT_API_KEY=
SCHOLAR_RAG_CHAT_MODEL=Qwen3-8B
SCHOLAR_RAG_EMBED_BACKEND=api
SCHOLAR_RAG_EMBED_BASE_URL=
SCHOLAR_RAG_EMBED_API_KEY=
SCHOLAR_RAG_EMBED_MODEL=Qwen3-VL-Embedding-2B
SCHOLAR_RAG_RERANK_BACKEND=api
SCHOLAR_RAG_RERANK_BASE_URL=
SCHOLAR_RAG_RERANK_API_KEY=
SCHOLAR_RAG_RERANK_MODEL=Qwen3-VL-Reranker-2B
SCHOLAR_RAG_MINERU_BACKEND=python
SCHOLAR_RAG_MINERU_API_URL=http://127.0.0.1:8010
SCHOLAR_RAG_MINERU_BIN=mineru
SCHOLAR_RAG_KEYWORDS_ENABLED=true
SCHOLAR_RAG_ANNOTATION_RESOLVER_ENABLED=true
SCHOLAR_RAG_JOB_WORKERS=1
SCHOLAR_RAG_CROSSREF_ENABLED=true
SCHOLAR_RAG_GROBID_URL=
SCHOLAR_RAG_LOG_LEVEL=WARNING
SCHOLAR_RAG_LOG_DIR=