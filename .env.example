# scholar-rag-mcp configuration
#
# All settings are also accepted from <data_dir>/config.json as a JSON object
# using the same keys without the SCHOLAR_RAG_ prefix (e.g. {"data_dir": "..."}).
# Environment variables always take precedence over config.json. Copy this file
# to .env (or set variables in your shell) and adjust values as needed.
#
# Path examples below use /path/to/... placeholders - replace them with your
# own local paths; nothing machine-specific is baked into defaults.

# ---- core storage ----------------------------------------------------------

# Root directory for knowledge-base data (kbs/, cache/, jobs.sqlite3, bin/).
SCHOLAR_RAG_DATA_DIR=~/.scholar-rag

# Qdrant: leave QDRANT_URL empty to auto-launch the bundled single binary at
# QDRANT_PORT with storage under QDRANT_STORAGE_DIR; or point it at an external
# instance (e.g. http://127.0.0.1:6333). The bundle downloads v1.12.5 (the
# highest version compatible with glibc 2.35) on first use.
SCHOLAR_RAG_QDRANT_URL=
# Path to a Qdrant binary to use instead of auto-downloading.
SCHOLAR_RAG_QDRANT_BIN=
# Port for the auto-launched Qdrant instance.
SCHOLAR_RAG_QDRANT_PORT=6333
# Qdrant data directory. MUST be on a local filesystem (9p/network mounts fail
# with EINVAL); home is local by default.
SCHOLAR_RAG_QDRANT_STORAGE_DIR=~/.local/share/scholar-rag/qdrant

# ---- model services (chat/embed/rerank) ------------------------------------
#
# Each group supports backend "api" (OpenAI-compatible HTTP, e.g. vLLM) or
# "local" (in-process transformers on this machine). With "api", *_BASE_URL is
# required and *_MODEL must match the served model name: scripts/serve_models.sh
# serves each *_MODEL directory under a short name equal to its basename, so for
# api usage *_MODEL should be that short name (e.g. Qwen3.5-0.8B).
#
# *_MODEL also feeds scripts/serve_models.sh, which needs the absolute path to
# the local HuggingFace model directory instead - set the path form when
# running the deployment script.

# Chat: section annotation + keyword extraction.
SCHOLAR_RAG_CHAT_BACKEND=api
SCHOLAR_RAG_CHAT_BASE_URL=http://127.0.0.1:8101/v1
SCHOLAR_RAG_CHAT_API_KEY=EMPTY
SCHOLAR_RAG_CHAT_MODEL=/path/to/models/Qwen/Qwen3.5-0.8B

# Embedding: chunk vectors (1024-dim; must match the model the kb was built with).
SCHOLAR_RAG_EMBED_BACKEND=api
SCHOLAR_RAG_EMBED_BASE_URL=http://127.0.0.1:8102/v1
SCHOLAR_RAG_EMBED_API_KEY=EMPTY
SCHOLAR_RAG_EMBED_MODEL=/path/to/models/jinaai/jina-embeddings-v5-text-small

# Rerank: query candidate re-ranking (optional; falls back to embed-only).
SCHOLAR_RAG_RERANK_BACKEND=api
SCHOLAR_RAG_RERANK_BASE_URL=http://127.0.0.1:8103/v1
SCHOLAR_RAG_RERANK_API_KEY=EMPTY
SCHOLAR_RAG_RERANK_MODEL=/path/to/models/jinaai/jina-reranker-v3.5

# ---- MinerU PDF parsing -----------------------------------------------------

# Backend: "python" (in-process, needs the mineru pixi environment), "cli"
# (call the MINERU_BIN executable), or "api" (external mineru-api service).
SCHOLAR_RAG_MINERU_BACKEND=python
# Base URL when MINERU_BACKEND=api.
SCHOLAR_RAG_MINERU_API_URL=http://127.0.0.1:8010
# Binary name/path when MINERU_BACKEND=cli.
SCHOLAR_RAG_MINERU_BIN=mineru

# ---- ingest behaviour -------------------------------------------------------

# Generate document keywords with the chat model (auto-disabled when chat is
# not configured).
SCHOLAR_RAG_KEYWORDS_ENABLED=true
# Resolve low-confidence annotation blocks with the chat model.
SCHOLAR_RAG_ANNOTATION_RESOLVER_ENABLED=true
# Number of concurrent ingest jobs (1 protects GPU memory; raise with care).
SCHOLAR_RAG_JOB_WORKERS=1
# Metadata enrichment via CrossRef by DOI (network).
SCHOLAR_RAG_CROSSREF_ENABLED=true
# Optional GROBID service URL for metadata extraction (empty = disabled).
SCHOLAR_RAG_GROBID_URL=

# ---- logging ----------------------------------------------------------------

# Log level: DEBUG/INFO/WARNING/ERROR (console handler uses this level).
SCHOLAR_RAG_LOG_LEVEL=WARNING
# Optional directory for a DEBUG-level file log (scholar-rag.log) in addition to the
# console handler. Empty = console only; when set, file logging starts on first use.
SCHOLAR_RAG_LOG_DIR=